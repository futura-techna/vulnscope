# VulnScope Production Environment Configuration
# Generate secure keys: python3 -c "import secrets; print(secrets.token_hex(32))"

# Application
VULNSCOPE_APP_NAME=VulnScope
VULNSCOPE_DEBUG=false
VULNSCOPE_ENVIRONMENT=production

# Security - REQUIRED (using demo values for local testing)
VULNSCOPE_SECRET_KEY=vulnscope-demo-secret-key-32-chars-minimum
VULNSCOPE_API_KEY=vulnscope-api-key-demo

# Database
POSTGRES_USER=vulnscope
POSTGRES_PASSWORD=vulnscope_dev_password
POSTGRES_DB=vulnscope
VULNSCOPE_DATABASE__URL=postgresql://vulnscope:vulnscope_dev_password@db:5432/vulnscope

# Redis
VULNSCOPE_REDIS__HOST=redis
VULNSCOPE_REDIS__PORT=6379
VULNSCOPE_REDIS__PASSWORD=vulnscope_redis_password

# Scanner
VULNSCOPE_SCANNER__MODE=active
VULNSCOPE_SCANNER__MAX_CONCURRENT_REQUESTS=50
VULNSCOPE_SCANNER__VERIFY_SSL=false

# Evidence
VULNSCOPE_EVIDENCE__STORAGE_PATH=/var/vulnscope/evidence
VULNSCOPE_EVIDENCE__ENCRYPTION_ENABLED=true
VULNSCOPE_EVIDENCE__RETENTION_DAYS=365

# Output
VULNSCOPE_OUTPUT_FORMAT=json
VULNSCOPE_OUTPUT_DIRECTORY=/var/vulnscope/reports

# Logging
VULNSCOPE_LOG_LEVEL=INFO
VULNSCOPE_LOG_FILE=/var/log/vulnscope/app.log

# MinIO (Optional)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
