# VulnScope Environment Configuration Example
# Copy this file to .env and configure for your environment

# ===================
# APPLICATION SETTINGS
# ===================
VULNSCOPE_APP_NAME=VulnScope
VULNSCOPE_DEBUG=false
VULNSCOPE_ENVIRONMENT=production

# ===================
# SECURITY - REQUIRED
# ===================
# Generate a strong secret key: python3 -c "import secrets; print(secrets.token_hex(32))"
VULNSCOPE_SECRET_KEY=changeme
VULNSCOPE_API_KEY=changeme_api_key

# ===================
# DATABASE
# ===================
VULNSCOPE_DATABASE__URL=postgresql://vulnscope:changeme_secure_password@db:5432/vulnscope
# DATABASE_URL is also supported for automatic detection (Render provides this)
# DATABASE_URL=postgresql://vulnscope:changeme_secure_password@db:5432/vulnscope
# Set to true to enable database persistence (default: false for in-memory storage)
USE_DATABASE=true

# ===================
# REDIS
# ===================
VULNSCOPE_REDIS__HOST=redis
VULNSCOPE_REDIS__PORT=6379
VULNSCOPE_REDIS__PASSWORD=changeme_redis_password

# ===================
# SCANNER CONFIGURATION
# ===================
VULNSCOPE_SCANNER__MODE=active
VULNSCOPE_SCANNER__MAX_CONCURRENT_REQUESTS=50
VULNSCOPE_SCANNER__VERIFY_SSL=true

# ===================
# EVIDENCE STORAGE
# ===================
VULNSCOPE_EVIDENCE__STORAGE_PATH=/var/vulnscope/evidence
VULNSCOPE_EVIDENCE__ENCRYPTION_ENABLED=true
VULNSCOPE_EVIDENCE__RETENTION_DAYS=365

# ===================
# OUTPUT
# ===================
VULNSCOPE_OUTPUT_FORMAT=json
VULNSCOPE_OUTPUT_DIRECTORY=/var/vulnscope/reports

# ===================
# LOGGING
# ===================
VULNSCOPE_LOG_LEVEL=INFO
VULNSCOPE_LOG_FILE=/var/log/vulnscope/app.log

# ===================
# MINIO/S3 (Optional)
# ===================
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=changeme_minio_password

# ===================
# EMAIL CONFIGURATION
# ===================
# Enable email sending (true/false)
VULNSCOPE_EMAIL__ENABLED=false

# Email Provider: 'resend' (recommended for Render) or 'smtp' (blocked on Render free tier)
VULNSCOPE_EMAIL__PROVIDER=resend

# ===========================================
# RESEND (Recommended for Render deployment)
# ===========================================
# 1. Create account at https://resend.com (free: 3000 emails/month)
# 2. Verify your domain or use onboarding@resend.dev for testing
# 3. Generate API key at https://resend.com/api-keys
VULNSCOPE_EMAIL__RESEND_API_KEY=re_xxxxxxxx

# Sender Information (must be verified in Resend)
VULNSCOPE_EMAIL__FROM_EMAIL=onboarding@resend.dev
VULNSCOPE_EMAIL__FROM_NAME=VulnScope

# Frontend URL (for email links)
VULNSCOPE_EMAIL__FRONTEND_URL=https://vulnscope-frontend.onrender.com

# ===========================================
# SMTP (BLOCKED on Render free tier - local only)
# ===========================================
# SMTP Server Configuration
# VULNSCOPE_EMAIL__SMTP_HOST=smtp.gmail.com
# VULNSCOPE_EMAIL__SMTP_PORT=587
# VULNSCOPE_EMAIL__SMTP_USER=your-email@gmail.com
# VULNSCOPE_EMAIL__SMTP_PASSWORD=your-app-password
# VULNSCOPE_EMAIL__SMTP_USE_TLS=true

# ===================
# EMAIL SETUP GUIDE
# ===================
# RESEND (Recommended for Render):
# 1. Create free account at https://resend.com
# 2. Add and verify your domain (or use onboarding@resend.dev for testing)
# 3. Create API key at https://resend.com/api-keys
# 4. Set VULNSCOPE_EMAIL__ENABLED=true
# 5. Set VULNSCOPE_EMAIL__PROVIDER=resend
# 6. Set VULNSCOPE_EMAIL__RESEND_API_KEY=re_xxxxxxxx
# 7. Set VULNSCOPE_EMAIL__FROM_EMAIL=your-verified-domain.com
#
# Gmail SMTP (Local development only - blocked on Render):
# 1. Enable 2FA on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Set PROVIDER=smtp and use your Gmail credentials
